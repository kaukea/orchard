{
  "permissions": {
    "defaultMode": "auto",
    "allow": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "root=\"$(git rev-parse --show-toplevel 2>/dev/null)\"; [ -x \"$root/.claude/hooks/courier-only-transport.sh\" ] && \"$root/.claude/hooks/courier-only-transport.sh\"; exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "gcd=\"$(git rev-parse --git-common-dir 2>/dev/null)\"; hit=\"\"; set -- \"$gcd/the-works\"/*/_closed; [ -e \"$1\" ] && hit=1; set -- \"$gcd/the-works\"/HANDOVER*.md; [ -f \"$1\" ] && hit=1; [ -n \"$hit\" ] && printf '{\"hookSpecificOutput\":{\"hookEventName\":\"UserPromptSubmit\",\"additionalContext\":\"Closed workstream(s) or legacy HANDOVER files await ingestion in .git/the-works/. Per the handover skill: read each _closed stream'\"'\"'s session logs oldest-first, promote pending decisions and remaining work into docs/decisions.md and the TODO, then delete the stream directory. Legacy flat HANDOVER*.md files: apply pending migrations first. Do this BEFORE responding to the user.\"}}'; exit 0",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "root=\"$(git rev-parse --show-toplevel 2>/dev/null)\"; [ -x \"$root/.claude/hooks/migrations-pending.sh\" ] && \"$root/.claude/hooks/migrations-pending.sh\"; exit 0",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "root=\"$(git rev-parse --show-toplevel 2>/dev/null)\"; [ -x \"$root/.claude/hooks/question-input-activity.sh\" ] && \"$root/.claude/hooks/question-input-activity.sh\"; exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "root=\"$(git rev-parse --show-toplevel 2>/dev/null)\"; [ -x \"$root/.claude/hooks/question-notification-backstop.sh\" ] && \"$root/.claude/hooks/question-notification-backstop.sh\"; exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "root=\"$(git rev-parse --show-toplevel 2>/dev/null)\"; [ -x \"$root/.claude/hooks/courier-init.sh\" ] && \"$root/.claude/hooks/courier-init.sh\"; exit 0",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "root=\"$(git rev-parse --show-toplevel 2>/dev/null)\"; [ -x \"$root/.claude/hooks/courier-end.sh\" ] && \"$root/.claude/hooks/courier-end.sh\"; exit 0",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
